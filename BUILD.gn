import("//build/ohos.gni")

ohos_shared_library("libhook_anymem") {
  sources = [ "malloc_free_hook.c" ]

  cflags = [
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  ldflags = [ "-Wl,--no-undefined" ]
}

ohos_shared_library("libhook_malloc_hole") {
  sources = [ "malloc_hole_hook.c" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  ldflags = [ "-Wl,--no-undefined" ]
}

ohos_shared_library("libhook_malloc_hole_passthrough") {
  sources = [ "malloc_hole_passthrough.c" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  ldflags = [ "-Wl,--no-undefined" ]
}

ohos_shared_library("libhook_malloc_hole_all_api_passthrough") {
  sources = [ "malloc_hole_all_api_passthrough.c" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  ldflags = [ "-Wl,--no-undefined" ]
}

ohos_shared_library("libhook_malloc_hole_no_writer") {
  sources = [ "malloc_hole_hook.c" ]

  defines = [ "MINI_HOLE_NO_WRITER=1" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  ldflags = [ "-Wl,--no-undefined" ]
}

ohos_shared_library("libhook_malloc_hole_probe") {
  sources = [ "malloc_hole_hook.c" ]

  defines = [ "MINI_HOLE_LOADER_PROBE=1" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-fPIC",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  ldflags = [ "-Wl,--no-undefined" ]
}

ohos_executable("libmini_replay_main") {
  sources = [ "replay_main.c" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]
}

# Build this target when trace_to_native.py is driven with the OpenHarmony
# cross compiler.  The generator appends the device-independent operation
# image to the resulting ELF.
ohos_executable("libmini_native_replay_runtime") {
  sources = [ "native_replay_runtime.c" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]
}

# Runtime used by rply_to_mstress.py. The generator appends a compact phase
# profile to the cross-compiled ELF.
ohos_executable("libmini_synthetic_mstress_runtime") {
  sources = [ "synthetic_mstress_runtime.c" ]

  cflags = [
    "-O3",
    "-DNDEBUG",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]
}
